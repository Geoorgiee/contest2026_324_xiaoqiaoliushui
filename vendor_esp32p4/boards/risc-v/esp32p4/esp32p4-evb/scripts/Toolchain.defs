# Toolchain definitions for ESP32-P4 (RISC-V RV32IMAFC)
#
# The ESP32-P4 uses a RISC-V core with the following ISA extensions:
#   I - Integer base
#   M - Integer multiplication/division
#   A - Atomic instructions
#   F - Single-precision floating point
#   C - Compressed instructions
#
# The ABI is ilp32f (32-bit integer/long/pointer, hardware float ABI).

# Toolchain prefix

CROSSDEV = riscv-none-elf-

# Toolchain binaries

CC = $(CROSSDEV)gcc
CXX = $(CROSSDEV)g++
AS = $(CROSSDEV)gcc -x assembler-with-cpp
AR = $(CROSSDEV)ar rcs
OBJCOPY = $(CROSSDEV)objcopy
OBJDUMP = $(CROSSDEV)objdump
LD = $(CROSSDEV)gcc
NXFLATLDFLAGS = -r -melf32lriscv
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS) -T $(TOPDIR)/binfmt/libnxflat/gencsym.ld -noentry -nostdlib
OBJCOPY = $(CROSSDEV)objcopy

# Architecture-specific CPU flags
#
# -march=rv32imafc  : RV32 with Integer, Multiply, Atomic, Float, Compressed
# -mabi=ilp32f      : 32-bit integer ABI with hardware float calling convention
# -mcmodel=medlow   : Medium-low code model (addresses in lower 2GB)

ARCHCPUFLAGS = -march=rv32imafc -mabi=ilp32f -mcmodel=medlow

# Architecture-specific C flags

ARCHCFLAGS = -fno-builtin -fno-strict-aliasing
ARCHCXXFLAGS = -fno-builtin -fno-strict-aliasing -fno-exceptions -fno-rtti

# Architecture-specific warning flags

ARCHWARNINGS = -Wall -Wstrict-prototypes -Wshadow -Wundef

# Architecture-specific optimization flags

ARCHOPTIMIZATION = -Os -fno-reorder-functions -ffunction-sections -fdata-sections

# Architecture-specific include paths

ARCHINCLUDES = -I$(TOPDIR)/include -I$(TOPDIR)/arch/risc-v/src/common -I$(TOPDIR)/arch/risc-v/src/rv32im

# Architecture-specific defines

ARCHDEFINES = -D__NuttX__ -D__riscv -D__ESP32P4__

# Linker flags

LDFLAGS = -nostdlib -Wl,--gc-sections
EXTRA_LIBS = -lgcc
