include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(BOARD_DIR)$(DELIM)scripts$(DELIM)Toolchain.defs

# Linker script for the ESP32-P4 EVB board.
#
# Memory layout:
#   Flash:  0x42000000 - 0x45FFFFFF (64MB cache window, 16MB physical)
#   SRAM:   0x4FF00000 - 0x4FFBFFFF (768KB)
#   PSRAM:  0x48000000 - 0x47FFFFFF (up to 32MB, if enabled)
#
# The linker script places .text and .rodata in flash (XIP),
# and .data and .bss in SRAM.

ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)ld.script

# Compiler flags for the ESP32-P4 EVB board.
#
# Architecture-specific flags are provided by Toolchain.defs:
#   ARCHCFLAGS   - C compiler flags for the target architecture
#   ARCHCXXFLAGS - C++ compiler flags
#   ARCHCPUFLAGS - CPU-specific flags (-march=rv32imafc, etc.)
#   ARCHINCLUDES - Architecture include paths
#   ARCHDEFINES  - Architecture-specific preprocessor defines
#
# We add -pipe for faster compilation and -Werror=return-type for strict
# return-type checking.  -Werror is intentionally omitted to allow upstream
# NuttX header warnings (e.g. forward-declared structs in usbhost.h) to
# compile without blocking the vendor build.
# -fpic is needed for position-independent code support (required by some
# ESP32-P4 bootloader stages).

ARCHPICFLAGS = -fpic

CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe -Werror=return-type -Wno-error=implicit-function-declaration
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS) -pipe
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__
